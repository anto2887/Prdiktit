# backend/Dockerfile.prod — Production image for API + scheduler (PRDIKTIT_RUN_SCHEDULER=1).
#
# Railway may use either build context:
#   • repo root (monorepo): includes ./backend/…
#   • service root = backend: top-level ./requirements.txt, ./app/
# The COPY + RUN block below supports both so the image always contains the real app under /app.

FROM python:3.12-slim AS builder

WORKDIR /tmp/build

RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    libpq-dev \
    python3-dev \
    build-essential \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

COPY . /src
RUN set -eux; \
    if [ -f /src/backend/requirements.txt ]; then \
      cp /src/backend/requirements.txt /tmp/build/requirements.txt; \
    elif [ -f /src/requirements.txt ]; then \
      cp /src/requirements.txt /tmp/build/requirements.txt; \
    else \
      echo "requirements.txt not found (checked /src/backend and /src)"; \
      find /src -maxdepth 3 -type f -name 'requirements.txt' || true; \
      exit 1; \
    fi

RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir --user -r requirements.txt

FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app \
    ENVIRONMENT=production

WORKDIR /app

RUN apt-get update && apt-get upgrade -y && apt-get install -y \
    libpq5 \
    curl \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

RUN useradd --create-home --shell /bin/bash app

COPY --from=builder /root/.local /home/app/.local

COPY . /src
RUN set -eux; \
    if [ -f /src/backend/requirements.txt ] && [ -d /src/backend/app ]; then \
      cp -a /src/backend/. /app/; \
    elif [ -f /src/requirements.txt ] && [ -d /src/app ]; then \
      cp -a /src/. /app/; \
    else \
      echo "Could not place backend code into /app"; \
      find /src -maxdepth 4 -type d -name app 2>/dev/null || true; \
      exit 1; \
    fi; \
    rm -rf /src

RUN chown -R app:app /app && \
    chown -R app:app /home/app/.local

USER app

ENV PATH="/home/app/.local/bin:$PATH"

EXPOSE 8000

# Inline health (no scripts/). Scheduler: /health; API: /docs.
HEALTHCHECK --interval=30s --timeout=15s --start-period=60s --retries=5 \
  CMD ["sh", "-c", "if [ \"${PRDIKTIT_RUN_SCHEDULER:-0}\" = \"1\" ]; then curl -fsS \"http://127.0.0.1:${PORT:-8000}/health\" >/dev/null; else curl -fsS \"http://127.0.0.1:${PORT:-8000}/docs\" >/dev/null; fi"]

# Gunicorn on $PORT, or scheduler when PRDIKTIT_RUN_SCHEDULER=1 (matches railway.json with no start override).
CMD ["sh", "-c", "set -e; cd /app; if [ \"${PRDIKTIT_RUN_SCHEDULER:-0}\" = \"1\" ]; then exec python -m app.scheduler_minimal; fi; exec gunicorn app.main:app -w \"${WEB_CONCURRENCY:-2}\" -k uvicorn.workers.UvicornWorker --bind \"0.0.0.0:${PORT:-8000}\" --access-logfile - --error-logfile -"]
